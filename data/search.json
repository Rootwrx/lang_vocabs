[{"w":"bring","pos":"v.","ar":"جيب","def":"To take something or someone with you to a place.","lg":"en","l":"by_level__Basic_Vocabulary_A1A2___part1","i":0,"c":[["bring something with you","جيب شي حاجة معاك"],["bring someone along","جيب معاك شي واحد"],["bring something up","يفتح موضوع / يذكر شي حاجة"],["bring something back","يرجع شي حاجة"]]},{"w":"almost","pos":"adv.","ar":"تقريباً / شوية وكان","def":"Very close to something, but not completely.","lg":"en","l":"by_level__Basic_Vocabulary_A1A2___part1","i":1,"c":[["almost everyone","تقريباً الناس كاملين"],["almost always","تقريباً ديما"],["almost ready","تقريباً واجد"],["almost forgot","شوية وكنت نسيت"]]},{"w":"have fun","pos":"exp.","ar":"تسلى / تهنا","def":"To enjoy yourself and have a good time.","lg":"en","l":"by_level__Basic_Vocabulary_A1A2___part1","i":2,"c":[["Have fun!","تسلى! / الله يعطيك التسلية"],["Did you have fun?","واش تسليتي؟"],["have fun doing something","تسلى فاش كيدير شي حاجة"],["have fun with someone","تسلى مع شي واحد"]]},{"w":"behind","pos":"prep./adv.","ar":"من ورا / مورا","def":"At the back of something; later or slower than planned.","lg":"en","l":"by_level__Basic_Vocabulary_A1A2___part1","i":3,"c":[["behind the door","من ورا الباب"],["behind schedule","متأخرين على الوقت المحدد"],["fall behind","يتأخر / يبقى من ورا"],["leave something behind","يخلي شي حاجة / ينساها"]]},{"w":"move","pos":"v./n.","ar":"تنقل / حرك","def":"To go to a new place or position; to change where you live.","lg":"en","l":"by_level__Basic_Vocabulary_A1A2___part1","i":4,"c":[["move to a new city","تنقل لمدينة جديدة"],["move out","يخرج من الدار / يخلي الكراء"],["move on to something","يدوز لحاجة أخرى"],["move your car","حرك الطوموبيل ديالك"]]},{"w":"find","pos":"v.","ar":"لقى","def":"To see or get something you were looking for; to discover something.","lg":"en","l":"by_level__Basic_Vocabulary_A1A2___part1","i":5,"c":[["find out","يعرف / يكتاشف"],["find it hard to do something","كيلقاها صعيبة باش يدير شي حاجة"],["find a job","يلقى خدمة"],["find time to do something","يلقى الوقت باش يدير شي حاجة"]]},{"w":"people","pos":"n.","ar":"الناس","def":"More than one person.","lg":"en","l":"by_level__Basic_Vocabulary_A1A2___part1","i":6,"c":[["people say","كيقولو الناس"],["a lot of people","بزاف د الناس"],["most people","أغلب الناس"],["young people","الشباب"]]},{"w":"make a mistake","pos":"exp.","ar":"يغلط / دير غلطة","def":"To do something wrong without wanting to.","lg":"en","l":"by_level__Basic_Vocabulary_A1A2___part1","i":7,"c":[["make a mistake","يغلط"],["make mistakes","يغلط (بزاف د المرات)"],["make a mistake in something","يغلط ف شي حاجة"],["Sorry, my mistake","سمح ليا، غلطتي"]]},{"w":"begin","pos":"v.","ar":"بدا","def":"To start to do something, or to start happening.","lg":"en","l":"by_level__Basic_Vocabulary_A1A2___part1","i":8,"c":[["begin with something","يبدا ب شي حاجة"],["begin to do something","يبدا كيدير شي حاجة"],["to begin with","فالأول / أول حاجة"],["What time does it begin?","فأنهي ساعة غادي يبدا؟"]]},{"w":"outside","pos":"adv./prep.","ar":"برا","def":"Not inside a building or place.","lg":"en","l":"by_level__Basic_Vocabulary_A1A2___part1","i":9,"c":[["go outside","خرج لبرا"],["outside the building","برا البناية"],["outside office hours","برا أوقات الخدمة"],["It's cold outside","الجو بارد برا"]]},{"w":"furthermore","pos":"adv.","ar":"علاوة على ذلك","def":"Used to add more information that supports what you have already said.","lg":"en","l":"IELTS__IELTS_Linking_Words__part1","i":0,"c":[["furthermore, it is important to","علاوة على ذلك، من المهم أن"],["furthermore, we need to","علاوة على ذلك، نحتاج إلى"],["furthermore, there is","علاوة على ذلك، هناك"]]},{"w":"on the other hand","pos":"exp.","ar":"من ناحية أخرى","def":"Used to introduce a different or opposite point of view.","lg":"en","l":"IELTS__IELTS_Linking_Words__part1","i":1,"c":[["on the one hand ... on the other hand","من ناحية ... ومن ناحية أخرى"],["on the other hand, it can be","من ناحية أخرى، يمكن أن يكون"],["on the other hand, some people","من ناحية أخرى، بعض الناس"]]},{"w":"consequently","pos":"adv.","ar":"وبالتالي","def":"Used to introduce a result or consequence of something.","lg":"en","l":"IELTS__IELTS_Linking_Words__part1","i":2,"c":[["consequently, we had to","وبالتالي، اضطررنا إلى"],["consequently, the company","وبالتالي، الشركة"],["consequently, I couldn't","وبالتالي، لم أستطع"]]},{"w":"for instance","pos":"exp.","ar":"على سبيل المثال","def":"Used to give a specific example of something.","lg":"en","l":"IELTS__IELTS_Linking_Words__part1","i":3,"c":[["for instance, you can","على سبيل المثال، يمكنك"],["for instance, some","على سبيل المثال، بعض"],["for instance, if you","على سبيل المثال، إذا"]]},{"w":"meanwhile","pos":"adv.","ar":"في هذه الأثناء","def":"Used to describe something happening while another thing is happening.","lg":"en","l":"IELTS__IELTS_Linking_Words__part1","i":4,"c":[["meanwhile, I'm going to","في هذه الأثناء، سأقوم بـ"],["meanwhile, the team","في هذه الأثناء، الفريق"],["meanwhile, you can","في هذه الأثناء، يمكنك"]]},{"w":"additionally","pos":"adv.","ar":"بالإضافة إلى ذلك","def":"Used to add another piece of information.","lg":"en","l":"IELTS__IELTS_Linking_Words__part1","i":5,"c":[["additionally, we need","بالإضافة إلى ذلك، نحتاج إلى"],["additionally, the course","بالإضافة إلى ذلك، الدورة"],["additionally, you can","بالإضافة إلى ذلك، يمكنك"]]},{"w":"at the same time","pos":"exp.","ar":"في الوقت نفسه","def":"Used when two or more things happen together or when two ideas are true together.","lg":"en","l":"IELTS__IELTS_Linking_Words__part1","i":6,"c":[["do two things at the same time","يقوم بأمرين في الوقت نفسه"],["at the same time, I understand","في الوقت نفسه، أفهم"],["both ... at the same time","كلاهما في الوقت نفسه"]]},{"w":"ultimately","pos":"adv.","ar":"في النهاية","def":"Used to describe the final result or the most important point after considering everything.","lg":"en","l":"IELTS__IELTS_Linking_Words__part1","i":7,"c":[["ultimately, it depends on","في النهاية، يعتمد الأمر على"],["ultimately, we decided to","في النهاية، قررنا أن"],["ultimately, the goal is to","في النهاية، الهدف هو"]]},{"w":"as a result","pos":"exp.","ar":"نتيجة لذلك","def":"Used to introduce the result of an action or situation.","lg":"en","l":"IELTS__IELTS_Linking_Words__part1","i":8,"c":[["as a result, I had to","نتيجة لذلك، اضطررت إلى"],["as a result, the system","نتيجة لذلك، النظام"],["as a result of something","نتيجة لشيء ما"]]},{"w":"as well as","pos":"exp.","ar":"بالإضافة إلى","def":"Used to add another person, thing, or activity to what has already been mentioned.","lg":"en","l":"IELTS__IELTS_Linking_Words__part1","i":9,"c":[["something as well as something","شيء بالإضافة إلى شيء آخر"],["as well as doing something","بالإضافة إلى القيام بشيء"],["as well as the ability to","بالإضافة إلى القدرة على"]]},{"w":"ami","pos":"nm","ar":"صديق","def":"Une personne qu’on aime bien et avec qui on passe du temps.","lg":"fr","l":"fr__by_level__Vocabulaire_d_butant_A1A2___part1","i":0,"c":[["un ami proche","صديق مقرّب"],["être ami avec qqn","يكون صديقًا لشخص"],["un ami de longue date","صديق من زمان"]]},{"w":"comprendre","pos":"v","ar":"يفهم","def":"Savoir ce que quelqu’un dit ou ce qu’une chose veut dire.","lg":"fr","l":"fr__by_level__Vocabulaire_d_butant_A1A2___part1","i":1,"c":[["comprendre quelque chose","يفهم شي حاجة"],["comprendre que…","يفهم أن…"],["faire comprendre","يوضّح لشخص / يخليه يفهم"]]},{"w":"maison","pos":"nf","ar":"دار / منزل","def":"Le bâtiment ou le lieu où on habite.","lg":"fr","l":"fr__by_level__Vocabulaire_d_butant_A1A2___part1","i":2,"c":[["être à la maison","يكون فالدار"],["rentrer à la maison","يرجع للدار"],["chez moi / chez qqn","عندي / عند شي واحد"]]},{"w":"se réveiller","pos":"v pron","ar":"يفيق / يستيقظ","def":"Arrêter de dormir.","lg":"fr","l":"fr__by_level__Vocabulaire_d_butant_A1A2___part1","i":3,"c":[["se réveiller tôt","يفيق بكري"],["se réveiller à + heure","يفيق مع ساعة معيّنة"],["réveiller qqn","يفيق شي واحد"]]},{"w":"écouter","pos":"v","ar":"يسمع بانتباه / ينصت","def":"Faire attention à un son ou à ce que quelqu’un dit.","lg":"fr","l":"fr__by_level__Vocabulaire_d_butant_A1A2___part1","i":4,"c":[["écouter de la musique","يسمع الموسيقى"],["écouter qqn","ينصت لشخص"],["bien écouter","يركّز فالسماع"]]},{"w":"à mon avis","pos":"exp","ar":"في رأيي / على حساب رأيي","def":"Une façon de dire ce que je pense.","lg":"fr","l":"fr__by_level__Vocabulaire_d_butant_A1A2___part1","i":5,"c":[["à mon avis","ف رأيي"],["et à ton avis ?","وانت شنو رأيك؟"],["à mon avis, + opinion","ف رأيي، + رأي"]]},{"w":"cuisine","pos":"nf","ar":"مطبخ / الطبخ","def":"La pièce où on prépare à manger; ou l’activité de préparer les repas.","lg":"fr","l":"fr__by_level__Vocabulaire_d_butant_A1A2___part1","i":6,"c":[["faire la cuisine","يطيب / يوجد الماكلة"],["être dans la cuisine","يكون فالمطبخ"],["la cuisine marocaine","الطبخ المغربي"]]},{"w":"famille","pos":"nf","ar":"العائلة","def":"Les personnes de la même famille : parents, enfants, frères, sœurs…","lg":"fr","l":"fr__by_level__Vocabulaire_d_butant_A1A2___part1","i":7,"c":[["ma famille","عائلتي"],["en famille","مع العائلة"],["un repas de famille","وجبة عائلية"]]},{"w":"proche","pos":"adj","ar":"قريب","def":"À petite distance; ou avec une relation forte avec quelqu’un.","lg":"fr","l":"fr__by_level__Vocabulaire_d_butant_A1A2___part1","i":8,"c":[["être proche de qqn","يكون مقرّب من شخص"],["tout près de","قريب بزاف من"],["un proche","واحد من المقرّبين"]]},{"w":"drôle","pos":"adj","ar":"مضحك / غريب","def":"Qui fait rire; parfois, qui est bizarre.","lg":"fr","l":"fr__by_level__Vocabulaire_d_butant_A1A2___part1","i":9,"c":[["être drôle","يكون مضحك"],["trouver qqch drôle","يشوف شي حاجة مضحكة"],["un drôle de + nom","شي حاجة غريبة"]]}]